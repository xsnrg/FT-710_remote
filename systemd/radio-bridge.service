# systemd --user unit for the rig-side Mumble <-> FT-710 bridge.
# Install: cp radio-bridge.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#          systemctl --user enable --now radio-bridge
# Settings: ~/.config/radio-bridge/bridge.env (copy server/radio-bridge/bridge.env.example).
[Unit]
Description=FT-710 <-> Mumble audio/PTT bridge (FT-710_remote)
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service

[Service]
EnvironmentFile=-%h/.config/radio-bridge/bridge.env
ExecStart=%h/radio-bridge/venv/bin/python -u %h/radio-bridge/radio_bridge.py
# Safety net: if the bridge died hard while it had keyed the rig, unkey it.
# Only fires when the bridge's own "keyed" marker exists, so it never unkeys other programs (fldigi etc.).
ExecStopPost=/bin/sh -c 'if [ -e %h/.cache/radio-bridge/keyed ]; then curl -s -m 3 -H "Content-Type: text/xml" -d "<?xml version=\\"1.0\\"?><methodCall><methodName>rig.set_ptt</methodName><params><param><value><i4>0</i4></value></param></params></methodCall>" "$${RB_FLRIG_URL:-http://127.0.0.1:12345/RPC2}" >/dev/null; rm -f %h/.cache/radio-bridge/keyed; fi'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
