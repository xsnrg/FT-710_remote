# FT-710 Remote network audio: operator-desktop receiver, ROC. Generated by ft710-remote into
# ~/.config/FT-710_remote/netaudio/receiver.conf and run as the user unit ft710-netaudio-recv.
# Creates the capture device "FT-710 RX (network)" (node ft710_rx_net, after RX gain + limiter)
# for WSJT-X, fldigi, etc.
context.properties = { log.level = 2 }
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt args = { nice.level = -11 } flags = [ ifexists nofail ] }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-roc-source
        args = {
            local.ip = "0.0.0.0"
            local.source.port = @PORT_SOURCE@
            local.repair.port = @PORT_REPAIR@
            local.control.port = @PORT_CONTROL@
            fec.code = @FEC@
            sess.latency.msec = @LATENCY@
            resampler.profile = medium
            audio.rate = 48000
            audio.channels = 1
            audio.position = [ MONO ]
            source.name = "@RAW_NODE@"
            source.props = {
                # raw network audio; the RX gain filter-chain below turns it into "FT-710 RX (network)"
                node.name = "@RAW_NODE@"
                node.description = "@RAW_DESC@"
                # a real capture device, not a playback stream to the speakers
                media.class = "Audio/Source"
                node.always-process = true
                node.pause-on-idle = false
                session.suspend-timeout-seconds = 0
            }
        }
    }
@RXGAIN_CHAIN@
]
