# ft710-scope settings: copy to ~/.config/ft710-scope/scope.env on the rig host and edit.
# Client networks allowed to connect (comma-separated CIDRs). Default: localhost only.
FT710_SCOPE_ALLOW=127.0.0.0/8,::1/128,192.168.1.0/24
# FT710_SCOPE_BIND=0.0.0.0
# FT710_SCOPE_PORT=7355
# FT710_SCOPE_LIB=~/ft710-scope/lib/libft4222.so
# FT710_FLRIG_HOST=127.0.0.1
# FT710_FLRIG_PORT=12345
