# ~/.config/ft710-txgate/txgate.env on the rig host (read by ft710-txgate.service after
# ~/.config/radio-bridge/bridge.env, see bridge.env.example, so RB_SINK / RB_FLRIG_URL / RB_HANG_S... are shared).
#
# Who may connect (CIDR list). Keep it to your LAN / VPN subnets. Default: localhost only.
TG_ALLOW=127.0.0.0/8,::1/128,192.168.1.0/24
# TCP control + UDP audio port (open it in the rig host's firewall for the allowed subnets).
#TG_PORT=10010
#TG_BIND=0.0.0.0
# Shared secret; created (mode 600) on first start. The app reads it over ssh.
#TG_TOKEN_FILE=~/.config/ft710-txgate/token
# Playback sink = the FT-710's USB audio output (defaults to RB_SINK from bridge.env).
#TG_SINK=
#TG_FLRIG_URL=http://127.0.0.1:12345/RPC2
# Timing: TX delay before audio, hang after release, TX timeout.
#TG_TX_DELAY_S=0.07
#TG_HANG_S=0.7
#TG_TX_TIMEOUT_S=120
# Safety: unkey when heartbeats stop for this long (control link loss unkeys at once).
#TG_HB_TIMEOUT_S=0.5
# Unkey when no mic audio arrives this long after keying, or audio stops mid-over for this long
# (silence is played meanwhile).
#TG_FIRST_AUDIO_S=2.0
#TG_GAP_S=2.0
# Refuse to key at all (testing the link without the radio).
#TG_SAFE=0
