# Rig config dir on the rig host: copy to ~/.config/radio-bridge/bridge.env and edit.
# (The dir name is historical: it was radio-bridge's before Mumble was removed. ft710-txgate,
# the app's network-audio sender and its status poll all use it; tx_enabled and tx_gain live there too.)

# PipeWire/PulseAudio names of the radio's USB audio (pactl list short sources / pactl list short sinks).
# RB_SOURCE: what the network-audio sender captures (the app's "Source node" setting overrides it).
# RB_SINK:   where ft710-txgate plays your TX audio (TG_SINK in txgate.env overrides it).
RB_SOURCE=alsa_input.usb-YOUR_AUDIO_DEVICE.mono-fallback
RB_SINK=alsa_output.usb-YOUR_AUDIO_DEVICE.analog-stereo

# flrig XML-RPC (PTT and VFO). flrig must run on this machine and own the CAT port.
RB_FLRIG_URL=http://127.0.0.1:12345/RPC2

# Optional TX timing shared with the gate (TG_* in txgate.env win): RB_HANG_S=0.7, RB_TX_TIMEOUT_S=120, RB_TX_DELAY_S=0.07
