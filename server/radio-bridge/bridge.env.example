# radio-bridge settings: copy to ~/.config/radio-bridge/bridge.env on the rig host and edit.
# Never commit your real file; the Mumble password goes in ~/.config/radio-bridge/server.pw (chmod 600).

# PipeWire/PulseAudio names of the radio's USB audio (pactl list short sources / pactl list short sinks). Required.
RB_SOURCE=alsa_input.usb-YOUR_AUDIO_DEVICE.mono-fallback
RB_SINK=alsa_output.usb-YOUR_AUDIO_DEVICE.analog-stereo

# Mumble server the bridge joins (usually murmur on the same machine) and the bridge's user name.
RB_MUMBLE_HOST=127.0.0.1
RB_MUMBLE_PORT=64738
RB_MUMBLE_USER=FT710
# RB_PASSWORD_FILE=~/.config/radio-bridge/server.pw   # optional; no file = no password

# flrig XML-RPC (PTT and VFO). flrig must run on this machine and own the CAT port.
RB_FLRIG_URL=http://127.0.0.1:12345/RPC2

# Where tx_enabled / tx_gain / rx_gain live.
# RB_CONFIG_DIR=~/.config/radio-bridge

# Levels and TX timing (defaults shown).
# RB_RX_GAIN=3.0
# RB_TX_GAIN=1.0
# RB_RX_BANDWIDTH=72000
# RB_HANG_S=0.7          # silence after the last Mumble packet before unkeying
# RB_TX_TIMEOUT_S=120    # hard transmit timeout
# RB_TX_DELAY_S=0.07
# RB_PREBUF_S=0.05
# RB_FADE_S=0.015
# RB_LEAD_S=0.06
# RB_MAX_BUF_S=0.4
